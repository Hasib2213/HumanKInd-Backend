DEBUG=True
SECRET_KEY=your_django_secret_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/

# SSLCommerz Configuration
STORE_ID=your_sslcommerz_store_id
STORE_PASS=your_sslcommerz_store_pass
SSL_COMMERZ_SANDBOX=True

# Database Configuration
DATABASE_ENGINE=django_mongodb_backend
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=AppName
MONGO_DB_NAME=HumanKind

# Cloudinary Credentials (for image/video storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# External Service URLs (Optional, overrides defaults)
# DAILY_AFFIRMATION_SERVICE_URL=http://187.127.98.88:8050/api/daily_affirmation
# AI_MEDITATION_SERVICE_URL=http://187.127.98.88:8050/api/AI_Meditation
# JOURNAL_SERVICE_URL=http://187.127.98.88:8050/api/journal
